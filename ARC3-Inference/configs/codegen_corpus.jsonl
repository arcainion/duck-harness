{"id":"bounded-search","code":"from collections import deque\nqueue = deque([(0, 0)])\nseen = {(0, 0)}\nwhile queue:\n    row, col = queue.popleft()\n    for nxt in ((row + 1, col), (row, col + 1)):\n        if nxt[0] <= 2 and nxt[1] <= 2 and nxt not in seen:\n            seen.add(nxt)\n            queue.append(nxt)\nresult = len(seen)","execute":true,"expected_result":9,"expect_action":false}
